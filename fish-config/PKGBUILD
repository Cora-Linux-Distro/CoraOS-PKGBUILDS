# Maintainer: CoraOS <support@coraos.org>

pkgname=coraos-fish-config
pkgver=1.0.0
pkgrel=1
pkgdesc="CoraOS Fish shell configuration and prompt"
arch=('any')
url="https://coraos.org"
license=('GPL-3.0-only')

depends=(
    'fish'
    'eza'
    'fzf'
    'fd'
    'bat'
    'zoxide'
)

optdepends=(
    'git: Git branch information in the developer prompt'
    'ttf-nerd-fonts-symbols: icons in the CoraOS prompt'
)

source=(
    'config.fish'
    'prompt.fish'
)

sha256sums=('737d543928e6b8554379cd4724647dbdb05057144e3b0f69505e4690b90cc343'
            'e28d3f4c1991315f7980ede0d79ff34bdda29643a1879d244c06601a553f3bec')

package() {
    install -Dm644 "$srcdir/config.fish" \
        "$pkgdir/usr/share/coraos/fish/config.fish"

    install -Dm644 "$srcdir/prompt.fish" \
        "$pkgdir/usr/share/fish/vendor_functions.d/fish_prompt.fish"

}

