# Maintainer: CoraOS <support@coraos.org>
pkgname=coraos-zsh-config
pkgver=2.0.0
pkgrel=2
pkgdesc="CoraOS zsh configuration"
arch=('any')
url="https://coraos.org"
license=('GPL-3.0-only')
depends=(
    'zsh'
    'zsh-autosuggestions'
    'zsh-syntax-highlighting'
    'zsh-history-substring-search'
    'eza'
    'fzf'
    'fd'
    'bat'
    'zoxide'
    'git'
    'nano'
)
source=(
    'starship.toml'
    'zshrcc'
    'zshrc'
)
sha256sums=('bdcd14e339644633184d584646f3b2dd7c0ab13fd178ffa6d985b546bb9cf98c'
            '2354172a69f3a702151d56381c58ff2b5f7ca0fcc5f113567a199edc7999ea9b'
            '6f53af4fc90d5b9e3af2a37d258fc9f54b50d6e783cddc3906da1a71d1bb3d07')

backup=('etc/zsh/zshrc')

package() {
    install -Dm644 "$srcdir/zshrcc" "$pkgdir/usr/share/coraos/zsh/coraos.zshrc"
    install -Dm644 "$srcdir/starship.toml" "$pkgdir/usr/share/coraos/zsh/starship.toml"
    install -Dm644 "$srcdir/zshrc" "$pkgdir/etc/zsh/zshrc"
}

